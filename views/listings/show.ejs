<% layout("/layouts/boilerplate") %>
    <script>
        const mapToken = "<%= process.env.MAP_TOKEN %>"
        const listing = <%- JSON.stringify(listing) %>
    </script>

 <!-- here script tag is for passing values to static files present in public folder -->

    <div class=" mt-3 mb-3">
        <b>
            <h4 class="offset-3">
                <%=listing.title%>
            </h4>
        </b>
        <div class="card offset-3 mb-3" style="width: 23rem;">

            <img src="<%=listing.image.url%>" class="card-img-top" alt="...">
            <p class=" mt-1 side">Owner:&nbsp;<%= listing.owner.username %>
            </p>
            <div class="card-body mt-0">
                <p class="card-text">
                    <%=listing.description%>
                </p>
            </div>

            <ul class="list-group list-group-flush">
                <li class="list-group-item">&#8377;<%=listing.price%>
                </li>
                <li class="list-group-item">
                    <%=listing.country%>
                </li>
                <li class="list-group-item">
                    <%=listing.location%>
                </li>
            </ul>

            <% if(currUsr && listing.owner._id.equals(currUsr._id)){%>
                <div class="card-body last">

                    <a href="/listings/<%= listing._id %>/edit" class="col-6">Edit this Listing</a>

                    <form action="/listings/<%= listing._id %>?_method=delete" method="post" class="">

                        <button class="btn">Delete</button>

                    </form>

                </div>
                <% } %>






        </div>

        <!-- review part -->

        <div class="col-8 offset-3 mb-3 border-top">
            <% if(currUsr) {%>
                <h4>
                    Leave a Review
                </h4>
                <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">

                    <div class="mt-3 mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-slot mt-2">

                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0"
                                checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>

                    <div class="mt-3 mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea type="text" id="comment" name="review[comment]" cols="30" rows="5"
                            class="form-control" required></textarea>

                        <div class="invalid-feedback">PLease submit some comments for review</div>
                    </div>
                    <button type="submit" class="btn outline-none">Submit</button>
                </form><br>
                <% } %>
                <% if(listing.reviews.length> 0) { %>
                    <div class="review">
                        <h4>All Reviews</h4>

                        <!-- using loops for showing reviews -->
                        <div class="row">
                            <% for(review of listing.reviews){%>

                                <div class="card col-sm-12 col-lg-5 ms-2 mt-2">
                                    <div class="card-body">
                                        <h4 class="card-title">@<%= review.author.username %>
                                        </h4>
                                        <p class="starability-result card-text" data-rating=<%=review.rating %>>
                                            Rated: <%= review.rating %> stars
                                        </p>
                                        <p class="card-text">
                                            <%= review.comment %>
                                        </p>


                                    </div>
                                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="post">
                                        <button type="submit" class="btn mb-2">Delete</button>
                                    </form>

                                </div>
                                <%}%>
                        </div>
                    </div>
                    <% } %>
        </div>
    </div>

    <div class="col-8 offset-3 mb-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
</div>
    <script src="/js/map.js"></script>