<% layout("/layouts/boilerplate") %>

    <div class=" mt-3 mb-3">
        <b>
            <h4 class="offset-3">
                <%=listing.title%>
            </h4>
        </b>
        <div class="card offset-3 mb-3" style="width: 23rem;">

            <img src="<%=listing.image.url%>" class="card-img-top" alt="...">
            <p class=" mt-1 side" >Owner:&nbsp;<%= listing.owner.username %></p>
            <div class="card-body mt-0">
                <p class="card-text">
                    <%=listing.description%>
                </p>
            </div>

            <ul class="list-group list-group-flush">
                <li class="list-group-item">&#8377;<%=listing.price%>
                </li>
                <li class="list-group-item">
                    <%=listing.country%>
                </li>
                <li class="list-group-item">
                    <%=listing.location%>
                </li>
            </ul>
            
            <% if(currUsr && listing.owner._id.equals(currUsr._id)){%>
            <div class="card-body last">

                <a href="/listings/<%= listing._id %>/edit" class="col-6">Edit this Listing</a>

                <form action="/listings/<%= listing._id %>?_method=delete" method="post" class="">

                    <button class="btn">Delete</button>

                </form>

            </div>
            <% } %>
       





        </div>

        <!-- review part -->
         
        <div class="col-8 offset-3 mb-3 border-top">
            <% if(currUsr) {%>
            <h4>
                Leave a Review
            </h4>
            <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">

                <div class="mt-3 mb-3">
                    <label for="rating">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]">
                </div>

                <div class="mt-3 mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea type="text" id="comment" name="review[comment]" cols="30" rows="5" class="form-control"
                        required></textarea>

                    <div class="invalid-feedback">PLease submit some comments for review</div>
                </div>
                <button type="submit" class="btn outline-none">Submit</button>
            </form><br>
            <% } %>
            <div class="review">
                <h4>All Reviews</h4>

                <!-- using loops for showing reviews -->
                <div class="row">
                <% for(review of listing.reviews){%>
                    
                    <div class="card col-sm-12 col-lg-5 ms-2 mt-2">
                        <div class="card-body">
                            <h4 class="card-title">@<%= review.author.username %></h4>
                            <p class="card-text"><%= review.comment %></p>
                            <p class="card-text"><%= review.rating %> Stars</p>
                        </div>
                        <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                            <button type="submit" class="btn mb-2">Delete</button> 
                        </form>
                        
                    </div>
                <%}%>
                </div>
            </div>
        </div>

        <br>


    </div>
    </div>