    <div class="container_ row row-cols-lg-6 row-cols-md-3 row-cols-sm-2 row-cols-xs-1">
        
        <% for(let listing of allListings ){ %>

            <a href="/listings/<%= listing._id %>">
            <div class="card_">
                <div class="card-img">
                <img src="<%= listing.image.url %>" alt="listing_image" class="img">
                 <div class="overlay">
                    <b><h4>Show more</h4></b>
                </div>
                    </div>
                    <div class="title">
                       <b><h4><%= listing.title %></h4></b>
                        <p class="card-text">
                        &#8377;<%= listing.price %>
                    </p>
               </div>
            </div>
            </a>
            <% } %>
    </div>